{
  "name": "nki-pyright",
  "languageId": "python",
  "command": [
    "basedpyright-langserver",
    "--stdio",
    "--cancellationReceive=file:%FILEHASH%"
  ],
  "settings": {
    "python.analysis": {
      "autoImportCompletions": true,
      "typeshedPaths": [],
      "stubPath": "",
      "useLibraryCodeForTypes": true,
      "diagnosticMode": "openFilesOnly",
      "typeCheckingMode": "basic",
      "logLevel": "verbose",
      "autoSearchPaths": true,
      "extraPaths": ["python", "nrtpy/python", "build/python/py-staging"]
    },
    "python": {
      "pythonPath": "/opt/nki-venv/bin/python",
      "venvPath": ""
    }
  }
}
