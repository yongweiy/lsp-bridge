{
  "name": "nki-pyright",
  "languageId": "python",
  "command": [
    "pyright-langserver",
    "--stdio"
  ],
  "settings": {
    "python.analysis": {
      "autoImportCompletions": true,
      "typeshedPaths": [],
      "stubPath": "",
      "useLibraryCodeForTypes": true,
      "diagnosticMode": "openFilesOnly",
      "typeCheckingMode": "basic",
      "logLevel": "verbose",
      "autoSearchPaths": true,
      "extraPaths": ["python", "nrtpy/python", "build/python/py-staging"]
    },
    "pythonPath": "/opt/nki-venv/bin/python",
    "venvPath": ""
  }
}
